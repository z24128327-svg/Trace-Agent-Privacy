{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRACE trial manifest interface",
  "type": "object",
  "required": ["trial_id", "split", "visible_query_history", "protected_units"],
  "additionalProperties": false,
  "properties": {
    "trial_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["evo", "admit", "shadow", "frozen_shift", "synthetic"]},
    "visible_query_history": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protected_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "source_record_id", "canonical_fields"],
        "additionalProperties": false,
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "source_record_id": {"type": "string", "minLength": 1},
          "canonical_fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
